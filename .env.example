# ——— Database (PostgreSQL) ———
# DATABASE_URL is the pooled connection the app uses at runtime.
# DATABASE_URL_UNPOOLED is a direct connection used for schema pushes.
# On Vercel, connecting a Neon database (Storage tab) sets both automatically.
# Locally, paste the same two values from your Neon dashboard, or point both at
# a local Postgres, e.g. postgresql://postgres@localhost:5432/wallverse
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ——— Site ———
# Optional. On Vercel the production domain is detected automatically; set this
# only to force a custom canonical domain.
# NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ——— Admin ———
# Credentials for the /admin dashboard. Change these before any deployment.
ADMIN_EMAIL="admin@wallverse.local"
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Use a long random string
# (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# ——— Payments (optional) ———
# Leave blank to run in clearly-labelled DEMO PAYMENT MODE.
# Provide Razorpay credentials to enable the real Razorpay checkout flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
