# Every variable here is optional. With none set, the store runs in static mode:
# the catalogue comes from src/data and no database is used.

# ——— Data source ———
# Set to "database" to store orders, enquiries and admin edits in PostgreSQL.
# DATA_SOURCE="database"

# ——— Database (only when DATA_SOURCE="database") ———
# DATABASE_URL is the pooled connection the app uses at runtime.
# DATABASE_URL_UNPOOLED is a direct connection used for schema pushes.
# On Vercel, connecting a Neon database (Storage tab) sets both automatically.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ——— Site ———
# On Vercel the production domain is detected automatically; set this only to
# force a custom canonical domain.
# NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ——— Admin (only when DATA_SOURCE="database") ———
# ADMIN_EMAIL="admin@wallverse.local"
# ADMIN_PASSWORD="change-me"
# Long random string signing the admin session cookie (e.g. `openssl rand -hex 32`).
# ADMIN_SESSION_SECRET="generate-a-long-random-string"

# ——— Payments (optional, only when DATA_SOURCE="database") ———
# Leave unset for clearly-labelled DEMO PAYMENT MODE.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
