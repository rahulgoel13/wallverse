# ——— Database ———
# SQLite file used for local development. No external database required.
DATABASE_URL="file:./dev.db"

# ——— Site ———
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— Admin ———
# Credentials for the /admin dashboard. Change these before any deployment.
ADMIN_EMAIL="admin@wallverse.local"
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET="generate-a-long-random-string"

# ——— Payments (optional) ———
# Leave blank to run in clearly-labelled DEMO PAYMENT MODE.
# Provide Razorpay credentials to enable the real Razorpay checkout flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
